{
  "schemaVersion": 1,
  "id": "timeline-plugin",
  "name": "ציר זמן",
  "version": "0.12.0",
  "description": "ציר זמן מקומי לאוצריא עם ממשק Desktop תואם אוצריא, ניווט מקלדת, חיפוש, תפריטי הקשר, רינדור מדורג ושחזור.",
  "author": "אברהם",
  "homepage": "https://github.com/avtsye/timeline-plugin",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.97",
  "sdkVersion": "1.x",
  "permissions": [
    "app.info.read",
    "app.shortcuts",
    "app.run_on_startup",
    "app.background_keep_alive",
    "app.startup_contributions",
    "history.read",
    "reader.open",
    "workspace.read",
    "workspace.manage",
    "navigation.write",
    "plugin.open_other",
    "notifications.send",
    "fs.user_files.read",
    "fs.user_files.write",
    "published_data.write",
    "plugin.storage.read",
    "plugin.storage.write",
    "events.subscribe:navigation.changed",
    "events.subscribe:reader.current_book_changed",
    "events.subscribe:reader.current_ref_changed",
    "events.subscribe:workspace.changed",
    "events.subscribe:theme.changed",
    "ui.feedback"
  ],
  "network": {
    "enabled": false,
    "allowlist": []
  },
  "contributes": {
    "toolTab": {
      "title": "ציר זמן",
      "iconName": "history_24_regular",
      "order": 80,
      "defaultPinned": true
    },
    "background": {
      "entrypoint": "background.html"
    },
    "startup": {
      "activationEvents": [
        "app.startup",
        "navigation.changed",
        "reader.current_book_changed",
        "reader.current_ref_changed",
        "workspace.changed"
      ],
      "keepAlive": true
    }
  },
  "stability": "experimental"
}