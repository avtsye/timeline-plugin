{
  "schemaVersion": 1,
  "id": "timeline-plugin",
  "name": "ציר זמן",
  "version": "0.1.0",
  "description": "ציר זמן מקומי לאוצריא: פעילות אחרונה, סשנים, חיפוש ושחזור מקומות עבודה.",
  "author": "אברהם",
  "homepage": "https://github.com/avtsye/timeline-plugin",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.98",
  "sdkVersion": "1.x",
  "permissions": [
    "app.info.read",
    "app.run_on_startup",
    "app.startup_contributions",
    "history.read",
    "reader.open",
    "plugin.storage.read",
    "plugin.storage.write",
    "events.subscribe:navigation.changed",
    "events.subscribe:reader.current_book_changed",
    "events.subscribe:workspace.changed"
  ],
  "network": {
    "enabled": false,
    "allowlist": []
  },
  "contributes": {
    "toolTab": {
      "title": "ציר זמן",
      "iconName": "history_24_regular",
      "order": 80,
      "defaultPinned": true
    },
    "background": {
      "entrypoint": "background.html"
    },
    "startup": {
      "activationEvents": [
        "app.startup",
        "navigation.changed",
        "reader.current_book_changed",
        "workspace.changed"
      ],
      "keepAlive": false
    }
  },
  "stability": "experimental"
}
