{
  "schemaVersion": 1,
  "id": "timeline-plugin",
  "name": "ציר זמן",
  "version": "0.7.0",
  "description": "ציר זמן מתקדם לאוצריא: Sessions, Snapshots, תוספים, ניתוח פעילות, גיבויים ושחזור.",
  "author": "אברהם",
  "homepage": "https://github.com/avtsye/timeline-plugin",
  "entrypoint": "index.html",
  "minAppVersion": "0.9.97",
  "sdkVersion": "1.x",
  "permissions": [
    "app.info.read",
    "app.shortcuts",
    "app.run_on_startup",
    "app.background_keep_alive",
    "app.startup_contributions",
    "history.read",
    "reader.open",
    "workspace.read",
    "workspace.manage",
    "navigation.write",
    "plugin.open_other",
    "notifications.send",
    "fs.user_files.read",
    "fs.user_files.write",
    "published_data.write",
    "plugin.storage.read",
    "plugin.storage.write",
    "events.subscribe:navigation.changed",
    "events.subscribe:reader.current_book_changed",
    "events.subscribe:reader.current_ref_changed",
    "events.subscribe:workspace.changed"
  ],
  "network": {"enabled": false, "allowlist": []},
  "contributes": {
    "toolTab": {"title":"ציר זמן","iconName":"history_24_regular","order":80,"defaultPinned":true},
    "background": {"entrypoint":"background.html"},
    "startup": {
      "activationEvents":["app.startup","navigation.changed","reader.current_book_changed","reader.current_ref_changed","workspace.changed"],
      "keepAlive": true,
      "shortcuts": [
        {"id":"open-timeline","label":"פתח ציר זמן","key":"ctrl+alt+t","command":"openTimeline"},
        {"id":"save-timeline-snapshot","label":"שמור Snapshot בציר הזמן","key":"ctrl+alt+s","command":"saveTimelineSnapshot"}
      ]
    }
  },
  "stability": "experimental"
}